# Copy this file to .env and fill in the values. Never commit .env.
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-6-luna

# Per-token prices in USD per 1 million tokens, from the provider's pricing page
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=

# Set to 1 during development to reuse cached model responses
LLM_CACHE=1
